# Salin isi berkas ini ke Streamlit Community Cloud → App → Settings → Secrets (JANGAN di-commit sebagai
# secrets.toml). Kunci tingkat atas otomatis menjadi variabel lingkungan yang dibaca src/config.py.

# Neon → Dashboard → Connect → connection string LANGSUNG (matikan "Connection pooling": host TANPA -pooler).
# Aplikasi sudah memakai kumpulan koneksinya sendiri; URL -pooler tetap didukung tetapi sedikit lebih lambat.
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Hash kata sandi peran (python -m src.auth), disalin dari .env lokal; tanda $ di dalamnya aman di TOML
CRS_HASH_ADMIN = "pbkdf2_sha256$600000$..."
CRS_HASH_DPA = "pbkdf2_sha256$600000$..."

# Salt anonimisasi NIM: sama dengan .env lokal. Hanya diperlukan untuk impor xlsx ber-NIM.
ANON_SALT = ""

# LLM: rating Bloom tersimpan di basis data dipakai ulang; kunci API hanya diperlukan bila penilaian baru
# dijalankan dari aplikasi (berbayar).
LLM_PROVIDER = "openai"
LLM_MODEL = "gpt-6-luna"
OPENAI_API_KEY = ""
