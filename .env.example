# Salin ke .env lalu isi. .env TIDAK PERNAH di-commit (KNF-04).

# Provider LLM pipeline: openai | anthropic | gemini | mock (luring, tanpa biaya)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna

# Kunci API (cukup isi provider yang dipakai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Salt anonimisasi NIM — samakan dengan salt data sebelumnya agar id_anon konsisten
ANON_SALT=

# Hash kata sandi peran (KF-22): jalankan `python -m src.auth`, salin baris keluarannya
CRS_HASH_ADMIN=
CRS_HASH_DPA=

# Hosting cloud (§11): kosong = SQLite lokal data/crs.db
DATABASE_URL=
